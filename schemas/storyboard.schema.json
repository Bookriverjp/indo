{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard",
  "type": "object",
  "required": [
    "scenes"
  ],
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "layout",
          "block_ids",
          "narration_text",
          "visual_summary",
          "estimated_seconds"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "layout": {
            "description": "config/layout.yaml の main.layouts",
            "enum": [
              "stage",
              "fullbleed",
              "card"
            ]
          },
          "block_ids": {
            "description": "script_main.json の block_id",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "narration_text": {
            "type": "string"
          },
          "visual_summary": {
            "type": "string"
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "time_of_day": {
            "type": [
              "string",
              "null"
            ]
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "background": {
            "type": [
              "string",
              "null"
            ]
          },
          "props": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "foreground": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fx": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggested_motion": {
            "type": [
              "string",
              "null"
            ]
          },
          "estimated_seconds": {
            "type": "number",
            "minimum": 0.1
          }
        }
      }
    }
  }
}
