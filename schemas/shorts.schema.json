{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShortsScript",
  "description": "60秒以内のショート台本。本編の script_main.json から作る。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "blocks", "cta_text"],
  "properties": {
    "schema_version": {"const": 1},
    "title": {"type": "string", "minLength": 1},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "kind", "text", "source_ids", "expression"],
        "properties": {
          "block_id": {"type": "string", "pattern": "^sb[0-9]{2}$"},
          "kind": {"enum": ["legend", "staging", "comment"]},
          "text": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "expression": {
            "enum": [
              "neutral", "point", "scared", "laugh", "cry", "joy", "serious", "sleep",
              "surprise", "think", "greet_namaste", "bow", "bell_cue", "nod", "head_shake",
              "whisper", "munch", "scroll", "dust_bath", "popcorn", "grooming"
            ]
          }
        }
      }
    },
    "cta_text": {"type": "string", "minLength": 1, "description": "本編への自然な導線（1文）"}
  }
}
