    {
      "target": "main",
      "block_id": "b28",
      "kind": "legend",
      "expression": "think",
      "voice": "narrator",
      "text": "ニシの話には、ちっと変わった決まりもあんだ。一部の語りじゃ、ニシは同じ人を二度までしか呼べねえ。だから三度目まで聞こえたら人間だ――っつう言い伝えがあんだよ。",
      "spoken_text": "ニシの話には、ちっと変わった決まりもあんだ。一部の語りじゃ、ニシは同じ人を二度までしか呼べねえ。だから三度目まで聞こえたら人間だ――っつう言い伝えがあんだよ。",
      "style_id": 61,
      "intonation": 0.4,
      "phrase_end_rise": 0.1,
      "file": "audio/generated/main_b28.wav",
      "seconds": 14.635,
      "params_hash": "6c6d68f4794fa28c"
    },
